# Parser Service Production Configuration
# Copy to .env on production server

# Backend URL for progress reporting - MUST be internal IP/hostname (NOT through Cloudflare)
BACKEND_URL=http://127.0.0.1:8080

# Parser service host/port
PARSER_HOST=0.0.0.0
PARSER_PORT=8082

# Download settings
USE_DDOWNLOADER=true
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO

# ── YouTube/yt-dlp Configuration ─────────────────────────
# Cookies file for yt-dlp (export from browser via yt-dlp --cookies-from-browser)
YTDLP_COOKIES_FILE=/opt/filmorauz/parser/cookies.txt
# Optional custom User-Agent
YTDLP_USER_AGENT=Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.210 Mobile Safari/537.36
# Optional proxy (e.g., socks5://127.0.0.1:1080 or http://127.0.0.1:8080)
YTDLP_PROXY=