# ── Worker environment ──────────────────────────────────
# Copy to .env for local development

# Environment mode: development or production
ENV=production

# MongoDB connection
MONGO_URI=mongodb+srv://jodev7:Josephnv2002%40%40@filmorauz.9hgcyzl.mongodb.net/?appName=filmorauz
MONGO_DB=filmorauz

# Parser service URL (INTERNAL - use internal IP not public domain)
PARSER_URL=http://127.0.0.1:8082

# Temp directory for processing
TEMP_DIR=./tmp

# Output directory for processed videos
OUTPUT_DIR=./processed

# Worker HTTP server port
WORKER_HTTP_PORT=8083

# ── Backend API Configuration ──────────────────────────
# Backend API URL (INTERNAL - use internal IP not public domain)
BACKEND_BASE_URL=http://173.249.8.13:8080

# Worker token for backend authentication (optional, set in backend .env)
WORKER_TOKEN=

# ── TMDB API (The Movie Database) ──────────────────────
# Get your API key from: https://www.themoviedb.org/settings/api
# This is REQUIRED for clean metadata and posters
TMDB_API_KEY=18320f8975834910e742abb58743a597

# ── AI Image Generation ─────────────────────────────────────
# 
# Option 1: OpenAI API (recommended for best quality)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=dall-e-3
#
# Option 2: Legacy custom AI endpoint (alternative to OpenAI)
# This is an alternative to OpenAI - if set, will be used instead of OpenAI
AI_ENDPOINT=

# ── Storage Configuration ──────────────────────────────
# Local storage path (for development)
LOCAL_STORAGE_PATH=./uploads

# Backblaze B2 Configuration (for production)
B2_BUCKET=filmorauznet
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_KEY_ID=005fb6ec66229a60000000001
B2_APP_KEY=

# CDN Base URL (for production)
CDN_BASE_URL=cdn.filmorauz.net

# ── Base URL for Local Development ──────────────────────────
# Used to generate full URLs in development mode
# Use internal IP for local development
BASE_URL=http://127.0.0.1:8080
