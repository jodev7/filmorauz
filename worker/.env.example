# ══════════════════════════════════════════════════════════════════════════════
# WATERMARK REMOVAL PIPELINE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# ── General Settings ──────────────────────────────────

# Enable/disable watermark removal
# Set to 'false' to skip watermark removal entirely
WATERMARK_ENABLED=true

# Processing mode: 'fast' (OpenCV) or 'pro' (LaMa neural network)
# FAST: Uses OpenCV inpainting - faster, CPU-friendly, good quality
# PRO: Uses LaMa neural network - higher quality but requires GPU
WATERMARK_MODE=fast

# ── Detection Settings ────────────────────────────────

# Number of frames to sample for watermark detection
# More frames = better detection but slower
WATERMARK_SAMPLE_COUNT=10

# Minimum confidence threshold (0.0-1.0) for watermark detection
# Higher = fewer false positives but may miss some watermarks
WATERMARK_CONFIDENCE_THRESHOLD=0.65

# Maximum number of watermark regions to detect and remove
# Excess regions are filtered by confidence
WATERMARK_MAX_REGIONS=3

# Enable OCR-based text watermark detection
# Recommended for detecting text overlays like site URLs
WATERMARK_USE_OCR=true

# Enable YOLO-based logo detection (requires ultralytics package)
# More accurate for logo detection but slower
WATERMARK_USE_YOLO=false

# ── Mask Generation ───────────────────────────────────

# Padding around detected watermarks (in pixels)
# Expands mask slightly to cover soft edges, glow, and shadows
WATERMARK_MASK_PADDING=8

# ── PRO Mode Settings ────────────────────────────────

# Enable automatic fallback from PRO to FAST mode if PRO fails
# Recommended: true
WATERMARK_PRO_FALLBACK_TO_FAST=true

# Path to LaMa model directory (for PRO mode)
# Leave empty to use default path
WATERMARK_LAMA_MODEL=

# Path to YOLO model file (for YOLO detection)
# Leave empty to use default path
WATERMARK_YOLO_MODEL=

# ── Processing Settings ──────────────────────────────

# Temporary directory for watermark processing
WATERMARK_TEMP_DIR=/tmp/filmora_watermark

# Timeout for inpainting operation (seconds)
WATERMARK_INPAINT_TIMEOUT=300

# Number of parallel workers for frame processing
WATERMARK_NUM_WORKERS=4

# Keep debug frames for analysis
# Set to 'true' for troubleshooting, 'false' for production
WATERMARK_KEEP_DEBUG_FRAMES=false

# ── HTTP Service Settings ────────────────────────────
# Alternative: Run watermark removal as a separate HTTP service

# URL for remote watermark removal service
# Leave empty to call Python directly from Go
WATERMARK_SERVICE_URL=

# Python interpreter path (for direct execution)
WATERMARK_PYTHON_PATH=python3

# ── Logging ─────────────────────────────────────────

# Logging level: DEBUG, INFO, WARNING, ERROR
WATERMARK_LOG_LEVEL=INFO
