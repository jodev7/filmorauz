# ── PROD environment ─────────────────────────────────
# Copy to .env on your production server
MODE=PROD
PORT=8080

# MongoDB with auth on production server
MONGO_URI=mongodb://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@localhost:27017/filmorauz?authSource=admin
DB_NAME=filmorauz

# REQUIRED in PROD — set strong values
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_TELEGRAM_ID=0
ADMIN_EMAIL=admin@filmorauz.uz
ADMIN_PASSWORD=change-this-to-a-strong-password

# Your production domain (used for CORS)
ALLOWED_ORIGIN=https://filmorauz.net

# Python parser service URL (set to your parser service address)
PARSER_SERVICE_URL=http://127.0.0.1:8082

# Website base URL (used for generating website_url for movies)
BASE_SITE_URL=https://filmorauz.net

# Backend URL for parser/worker callbacks (internal, direct IP/hostname, NOT through Cloudflare)
# Example: BACKEND_URL=http://10.0.0.5:8080
BACKEND_URL=http://127.0.0.1:8080

# ── Backblaze B2 (backend direct upload for profile images) ───────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=
B2_ENDPOINT=
B2_PUBLIC_URL=https://cdn.filmorauz.net/file/filmorauznet

# Worker upload URL remains for movie/series/video processing flows only
WORKER_UPLOAD_URL=http://127.0.0.1:8083

# Media protection defaults
MEDIA_PROTECTED_BASE_URL=/media
MEDIA_COOKIE_NAME=filmorauz_media
MEDIA_TOKEN_TTL_SECONDS=60
