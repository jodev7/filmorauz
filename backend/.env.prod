# ── PROD environment ─────────────────────────────────
# Copy to .env on your production server
MODE=PROD
PORT=8080

# MongoDB with auth on production server
MONGO_URI=mongodb://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@localhost:27017/filmorauz?authSource=admin
DB_NAME=filmorauz

# REQUIRED in PROD — set strong values
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@filmorauz.uz
ADMIN_PASSWORD=change-this-to-a-strong-password

# Your production domain (used for CORS)
ALLOWED_ORIGIN=https://filmorauz.net

# Python parser service URL (set to your parser service address)
PARSER_SERVICE_URL=http://127.0.0.1:8082

# Website base URL (used for generating website_url for movies)
BASE_SITE_URL=https://filmorauz.net
