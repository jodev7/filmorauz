# ── DEV environment ──────────────────────────────────
# Copy to .env for local development
MODE=DEV
PORT=8080

# Local MongoDB (no auth) — installed directly on your machine
MONGO_URI=mongodb://localhost:27017
DB_NAME=filmorauz

# These are optional in DEV — defaults are used if missing
JWT_SECRET=dev-only-secret
ADMIN_EMAIL=admin@filmorauz.uz
ADMIN_PASSWORD=admin123

# Python parser service URL (default: http://127.0.0.1:8082)
PARSER_SERVICE_URL=http://127.0.0.1:8082

# GIPHY API key for the watch-room chat GIF picker (https://developers.giphy.com).
# Server-side only — proxied via /api/gifs/search so it's never sent to the browser.
GIPHY_API_KEY=

# TMDB: actors + photos for movies/series (background job + admin button).
# v3 API key is enough; TMDB_READ_TOKEN (v4 Bearer) is used instead when set.
TMDB_API_KEY=18320f8975834910e742abb58743a597
TMDB_READ_TOKEN=

# Optional Backblaze B2 config for testing backend-direct profile uploads in PROD-like setups
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=
B2_ENDPOINT=
B2_PUBLIC_URL=https://cdn.filmorauz.net/file/filmorauznet

# Media protection defaults
MEDIA_PROTECTED_BASE_URL=/media
MEDIA_COOKIE_NAME=filmorauz_media
MEDIA_TOKEN_TTL_SECONDS=60

# Web push notifications (generate: go run ./cmd/vapid-keys). Empty = push disabled.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@filmorauz.net
