# ── DEV environment ──────────────────────────────────
# Copy to .env for local development
MODE=DEV
PORT=8080

# Local MongoDB (no auth) — installed directly on your machine
MONGO_URI=mongodb://localhost:27017
DB_NAME=filmorauz

# These are optional in DEV — defaults are used if missing
JWT_SECRET=dev-only-secret
ADMIN_EMAIL=admin@filmorauz.uz
ADMIN_PASSWORD=admin123

# Python parser service URL (default: http://127.0.0.1:8082)
PARSER_SERVICE_URL=http://127.0.0.1:8082
