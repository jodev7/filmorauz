# ── PROD ─────────────────────────────────────────────
# Copy to .env.local on your production server
NEXT_PUBLIC_API_URL=https://api.filmorauz.net/api
NEXT_PUBLIC_WORKER_URL=https://api.filmorauz.net

# Public B2 bucket — images are served directly from the CDN without a signed
# token. These MUST be NEXT_PUBLIC_* so both SSR and the browser resolve the
# same URL; otherwise client-side navigation falls back to the default
# "protected" mode and images 404.
NEXT_PUBLIC_MEDIA_ACCESS_MODE=public
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.filmorauz.net/file/filmorauznet
