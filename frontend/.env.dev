# ── DEV ──────────────────────────────────────────────
# Copy to .env.local for local development
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WORKER_URL=http://localhost:8083
# GIPHY API key for the watch-room chat GIF picker (https://developers.giphy.com).
# Without it the GIF button shows a "not configured" message; emoji/chat still work.
NEXT_PUBLIC_GIPHY_API_KEY=
